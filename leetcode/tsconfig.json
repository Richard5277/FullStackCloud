{
  "compilerOptions": {
    "target": "es2015",
    "module": "esnext",
    "lib": ["ES2016", "DOM"],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "noEmit": true
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": ["src/*.ts", "../tasks/map2.ts"],
  "exclude": ["node_modules", "dist"]
}